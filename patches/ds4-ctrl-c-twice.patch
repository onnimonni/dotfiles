+/* A single Ctrl+C is the usual interrupt-generation / edit-cancel key.  A
+ * second Ctrl+C within AGENT_CTRL_C_DOUBLE_MS quits the whole agent; the
+ * teardown after the UI loop frees the worker and the caller closes the ds4
+ * engine, so one process exit shuts down both ds4-agent and the embedded ds4.
+ * State is touched only from the UI thread, so no locking is needed. */
+#define AGENT_CTRL_C_DOUBLE_MS 500
+static struct timespec agent_ctrl_c_last;
+static bool agent_ctrl_c_armed;
+
+static void agent_handle_ctrl_c(agent_editor *editor, agent_worker *worker,
+                                const char *prompt, const char *statusline,
+                                bool *running) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    bool double_press = false;
+    if (agent_ctrl_c_armed) {
+        long long ms = (now.tv_sec - agent_ctrl_c_last.tv_sec) * 1000 +
+                       (now.tv_nsec - agent_ctrl_c_last.tv_nsec) / 1000000;
+        double_press = ms >= 0 && ms <= AGENT_CTRL_C_DOUBLE_MS;
+    }
+    agent_ctrl_c_armed = false;
+    if (double_press) {
+        /* Second Ctrl+C: quit the agent, closing the ds4 engine too. */
+        *running = false;
+        return;
+    }
+    agent_ctrl_c_last = now;
+    agent_ctrl_c_armed = true;
+    if (!worker_is_idle(worker)) {
+        worker_interrupt(worker);
+    } else {
+        editor_cancel_input_with_hint(editor, prompt, statusline);
+    }
+}
+
 /* Main UI loop.  poll() multiplexes stdin with the worker wake pipe; all
  * terminal writes go through editor_write_async() so linenoise, status footer,
  * model output, and tool output never race each other. */
