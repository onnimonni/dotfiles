                 cli_interrupt_clear();
+                if (cli_ctrl_c_double_take()) break; /* 2nd Ctrl+C: exit */
                 continue;
             }
             break;
@@ -1857,6 +1906,8 @@ static int run_repl(ds4_engine *engine, cli_config *cfg) {
             rc = run_chat_turn(engine, cfg, &chat, cmd, NULL);
         }
         linenoiseFree(line);
+        /* Two Ctrl+C presses during generation quit the whole ds4 process. */
