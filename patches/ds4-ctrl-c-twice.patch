diff --git a/ds4_cli.c b/ds4_cli.c
index af4e2b6..abf4ab4 100644
--- a/ds4_cli.c
+++ b/ds4_cli.c
@@ -108,11 +108,31 @@ static volatile sig_atomic_t cli_interrupted;
 static volatile sig_atomic_t cli_dist_busy;
 static volatile sig_atomic_t cli_dist_notice_printed;
 
+/* Two Ctrl+C presses within CLI_CTRL_C_DOUBLE_MS quit the whole ds4 process
+ * (the CLI and the engine it hosts); a single press is the usual interrupt /
+ * cancel.  cli_ctrl_c_last is written by the SIGINT handler (clock_gettime is
+ * async-signal-safe) and by the UI thread for raw-mode byte 3; the UI thread
+ * owns the reads, and the latched cli_ctrl_c_double flag below keeps the
+ * non-atomic struct write/read race benign. */
+#define CLI_CTRL_C_DOUBLE_MS 500
+static struct timespec cli_ctrl_c_last;
+static volatile sig_atomic_t cli_ctrl_c_last_set;
+static volatile sig_atomic_t cli_ctrl_c_double;
+
 static const char cli_dist_drain_msg[] =
     "\nds4: stopping after the distributed cluster finishes the current token/chunk...\n";
 
 static void cli_sigint_handler(int sig) {
     (void)sig;
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    if (cli_ctrl_c_last_set) {
+        long long ms = (now.tv_sec - cli_ctrl_c_last.tv_sec) * 1000 +
+                       (now.tv_nsec - cli_ctrl_c_last.tv_nsec) / 1000000;
+        if (ms >= 0 && ms <= CLI_CTRL_C_DOUBLE_MS) cli_ctrl_c_double = 1;
+    }
+    cli_ctrl_c_last = now;
+    cli_ctrl_c_last_set = 1;
     cli_interrupted = 1;
     if (cli_dist_busy && !cli_dist_notice_printed) {
         cli_dist_notice_printed = 1;
@@ -132,6 +152,29 @@ static void cli_interrupt_clear(void) {
     cli_dist_notice_printed = 0;
 }
 
+/* Record a raw-mode byte-3 Ctrl+C (UI thread) and latch the double-press flag
+ * when it falls inside the window of the previous press.  SIGINT presses are
+ * already timestamped by cli_sigint_handler, so this path only records. */
+static void cli_prompt_ctrl_c(void) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    if (cli_ctrl_c_last_set) {
+        long long ms = (now.tv_sec - cli_ctrl_c_last.tv_sec) * 1000 +
+                       (now.tv_nsec - cli_ctrl_c_last.tv_nsec) / 1000000;
+        if (ms >= 0 && ms <= CLI_CTRL_C_DOUBLE_MS) cli_ctrl_c_double = 1;
+    }
+    cli_ctrl_c_last = now;
+    cli_ctrl_c_last_set = 1;
+}
+
+static bool cli_ctrl_c_double_take(void) {
+    if (cli_ctrl_c_double) {
+        cli_ctrl_c_double = 0;
+        return true;
+    }
+    return false;
+}
+
 static bool cli_distributed_coordinator(const cli_config *cfg) {
     return cfg && cfg->engine.distributed.role == DS4_DISTRIBUTED_COORDINATOR;
 }
